{"id":"color","duration":59.63,"voice":"Juniper","segments":[{"t":0,"cap":"Pick a color scheme from the data, not from taste."},{"t":4.39,"cap":"Sequential schemes go from light to dark in one hue, for ordered values from low to high, like counts, rates or minutes."},{"t":14.07,"cap":"Diverging schemes use two hues that meet at a meaningful middle, like zero, an average or a target, for values above and below it."},{"t":23.85,"cap":"Qualitative schemes use unrelated hues of similar lightness, for categories with no order, like majors or dining halls."},{"t":32.86,"cap":"Watch for three common mistakes."},{"t":35.85,"cap":"A rainbow or qualitative scheme on ordered data: without the legend, nobody can tell which color means more."},{"t":44.12,"cap":"A diverging scheme with no meaningful middle."},{"t":47.96,"cap":"And red next to green: about one man in twelve cannot tell them apart."},{"t":54.83,"cap":"Use color sparingly, and let it carry a variable."}],"items":[{"k":"hand","page":0,"t":0.25,"x":44,"y":30,"h":54,"text":"Color follows the data","d":0.77,"big":true,"color":"red"},{"k":"hand","page":0,"t":4.39,"x":44,"y":84,"h":44,"text":"sequential: light to dark,","d":0.91},{"k":"hand","page":0,"t":9.37,"x":78,"y":128,"h":44,"text":"low to high","d":0.5},{"k":"sketch","page":0,"t":4.39,"name":"schemes","box":{"x":500,"y":96,"w":430,"h":414},"phases":[14.07,23.85]},{"k":"hand","page":0,"t":14.07,"x":44,"y":172,"h":44,"text":"diverging: two hues,","d":0.7},{"k":"hand","page":0,"t":16.87,"x":78,"y":216,"h":44,"text":"a meaningful middle","d":0.67},{"k":"hand","page":0,"t":18.05,"x":78,"y":260,"h":44,"text":"(zero, average, target)","d":0.81},{"k":"hand","page":0,"t":23.85,"x":44,"y":304,"h":44,"text":"qualitative: separate hues,","d":0.95},{"k":"hand","page":0,"t":27.9,"x":78,"y":348,"h":44,"text":"for categories","d":0.5},{"k":"page","page":1,"t":32.86},{"k":"hand","page":1,"t":33.11,"x":44,"y":30,"h":54,"text":"Three mistakes","d":0.5,"big":true,"color":"red"},{"k":"